rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media for quotes / jobs / logos. Public read (URLs are unguessable, and they're embedded in customer documents);
    // writes only by the business owner or a registered member, max 10 MB per file.
    match /businesses/{bizId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == bizId
            || firestore.exists(/databases/(default)/documents/businesses/$(bizId)/members/$(request.auth.uid)))
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
