rules_version = '2';
// EMERGENCY ROLLBACK — the exact permissive rules the Israeli app shipped with.
// Deploy this if IL users suddenly see an empty/"reset" app after a rules change.
//   copy /Y firestore.rules.legacy-emergency firestore.rules
//   firebase use zikkit-e87ff
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /businesses/{bizId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /tech_lookup/{lookupKey} {
      allow read, write: if request.auth != null;
    }
    match /invites/{token} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /super_admins/{userId} {
      allow read: if request.auth != null;
    }
    match /public_portals/{token} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bot_conversations/{callId} {
      allow read, write: if true;
    }
    match /phone_lookup/{phoneNumber} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /agreements/{agreementId} {
      allow read, write: if request.auth != null;
    }
    match /licenses/{licenseId} {
      allow read: if request.auth != null;
    }
  }
}
