rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function emailKey() { return request.auth.token.email.lower().replace('[@.]', '_'); }
    function isOwner(bizId) { return signedIn() && request.auth.uid == bizId; }
    function isSuperAdmin() { return signedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)); }
    function isMember(bizId) { return signedIn() && exists(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid)); }
    function canAccess(bizId) { return isOwner(bizId) || isMember(bizId) || isSuperAdmin(); }
    function lookupPointsHere(bizId) {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/tech_lookup/$(emailKey()))
        && get(/databases/$(database)/documents/tech_lookup/$(emailKey())).data.bizId == bizId;
    }

    // Per-user record
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /super_admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
    }

    // Business = tenant. The owner's uid IS the business id.
    // Previously: any signed-in user could read AND write any business. Now: owner, registered members, super admins.
    match /businesses/{bizId} {
      allow read: if canAccess(bizId);
      allow create: if isOwner(bizId);
      allow update: if canAccess(bizId);
      allow delete: if isOwner(bizId) || isSuperAdmin();

      // Membership — a technician registers themself once tech_lookup points at this business
      match /members/{uid} {
        allow read: if canAccess(bizId);
        allow create, update: if signedIn() && request.auth.uid == uid && (isOwner(bizId) || lookupPointsHere(bizId));
        allow delete: if isOwner(bizId) || isSuperAdmin() || request.auth.uid == uid;
      }

      // Every data collection (jobs, quotes, customers, receipts, closings, counters, presence, backups, …)
      match /{sub}/{docId} {
        allow read: if canAccess(bizId);
        allow write: if canAccess(bizId) && sub != 'members';
      }
      match /{sub}/{docId}/{rest=**} {
        allow read, write: if canAccess(bizId) && sub != 'members';
      }
    }

    // Email → business lookup for team members (owner writes when inviting; techs read at login)
    match /tech_lookup/{lookupKey} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.resource.data.bizId == request.auth.uid || isSuperAdmin());
      allow delete: if signedIn() && (resource.data.bizId == request.auth.uid || isSuperAdmin());
    }

    // Customer-facing snapshots (quotes / receipts). World-readable by unguessable token; written by the business.
    match /public_portals/{token} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    match /phone_lookup/{phoneNumber} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Server-side only (voice/SMS routes use the admin SDK). Was "read, write: if true" — closed.
    match /bot_conversations/{callId} {
      allow read, write: if false;
    }

    match /agreements/{agreementId} {
      allow read, write: if signedIn();
    }

    match /licenses/{licenseId} {
      allow read: if signedIn();
    }
  }
}
