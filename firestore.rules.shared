rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// SHARED-PROJECT rules: CA runs on the SAME Firebase project as IL.
// Legacy top-level paths stay exactly as permissive as before (so the IL app and
// its bot routes keep working); the new per-record subcollections are role-scoped.
// Deploy: copy over firestore.rules → firebase deploy --only firestore:rules,storage
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function emailKey() { return request.auth.token.email.lower().replace('[@.]', '_'); }
    function isOwner(bizId) { return signedIn() && request.auth.uid == bizId; }
    function isSuperAdmin() { return signedIn() && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)); }
    function memberDoc(bizId) { return get(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid)); }
    function isMember(bizId) { return signedIn() && exists(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid)); }
    function memberRole(bizId) { return memberDoc(bizId).data.role; }
    // Only the owner (and a legacy manager) runs the whole business.
    // Field roles — technician AND partner — read and write only records assigned to them.
    // The office role — dispatcher — touches leads and nothing else.
    function isStaff(bizId) { return isOwner(bizId) || isSuperAdmin() || (isMember(bizId) && memberRole(bizId) == 'manager'); }
    function isTech(bizId) { return isMember(bizId) && memberRole(bizId) in ['technician', 'tech', 'partner']; }
    function isOffice(bizId) { return isMember(bizId) && memberRole(bizId) == 'dispatcher'; }
    function canAccess(bizId) { return isStaff(bizId) || isTech(bizId) || isOffice(bizId); }
    function lookup() { return get(/databases/$(database)/documents/tech_lookup/$(emailKey())); }
    function lookupPointsHere(bizId) {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/tech_lookup/$(emailKey()))
        && lookup().data.bizId == bizId && lookup().data.active != false;
    }
    function ownsRecord() { return resource.data.techUid == request.auth.uid; }
    function writesOwnRecord() { return request.resource.data.techUid == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // LEGACY (unchanged): the IL client still reads other businesses at tech login
    match /businesses/{bizId} {
      allow read: if signedIn();
      allow write: if signedIn();

      // Membership — a team member registers themself once tech_lookup points at this business.
      // The role stored here MUST equal the role the owner set in tech_lookup (no self-promotion).
      match /members/{uid} {
        allow read: if canAccess(bizId);
        allow create, update: if signedIn() && request.auth.uid == uid
          && (isOwner(bizId) || (lookupPointsHere(bizId) && request.resource.data.role == lookup().data.role));
        allow delete: if isOwner(bizId) || isSuperAdmin() || request.auth.uid == uid;
      }

      // Leads: the office writes these; nobody else in the field sees them
      match /leads/{docId} {
        allow read, write: if isStaff(bizId) || isOffice(bizId);
      }

      // Jobs: staff see everything; technicians only jobs assigned to them (query must filter techUid == uid)
      match /jobs/{docId} {
        allow read: if isStaff(bizId) || (isTech(bizId) && ownsRecord());
        allow create, delete: if isStaff(bizId);
        allow update: if isStaff(bizId) || (isTech(bizId) && ownsRecord() && writesOwnRecord());
      }

      // Closings: technicians may create/update only their own
      match /closings/{docId} {
        allow read: if isStaff(bizId) || (isTech(bizId) && ownsRecord());
        allow create: if isStaff(bizId) || (isTech(bizId) && writesOwnRecord());
        allow update: if isStaff(bizId) || (isTech(bizId) && ownsRecord() && writesOwnRecord());
        allow delete: if isStaff(bizId);
      }

      // Presence (GPS): each member writes their own tiny doc
      match /presence/{uid} {
        allow read: if canAccess(bizId);
        allow write: if canAccess(bizId) && request.auth.uid == uid;
      }

      // Everything else (customers, quotes, receipts, products, users, counters, backups, …): staff only
      match /{sub}/{docId} {
        allow read, write: if isStaff(bizId) && sub != 'members' && sub != 'jobs' && sub != 'closings' && sub != 'presence' && sub != 'leads';
      }
      match /{sub}/{docId}/{rest=**} {
        allow read, write: if isStaff(bizId) && sub != 'members';
      }
    }

    match /tech_lookup/{lookupKey} {
      allow read, write: if signedIn();
    }

    match /invites/{token} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.bizId == request.auth.uid;
      allow delete: if signedIn() && resource.data.bizId == request.auth.uid;
      allow update: if signedIn() && (resource.data.bizId == request.auth.uid || request.auth.token.email.lower() == resource.data.email);
    }

    match /super_admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
    }

    match /public_portals/{token} {
      allow read: if true;
      allow write: if signedIn();
    }

    // LEGACY (unchanged): voice/SMS routes still hit these without auth
    match /bot_conversations/{callId} {
      allow read, write: if true;
    }
    match /phone_lookup/{phoneNumber} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /agreements/{agreementId} {
      allow read, write: if signedIn();
    }

    match /licenses/{licenseId} {
      allow read: if signedIn();
    }
  }
}
