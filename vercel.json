{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/expire-calls",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/dunning",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "src/app/api/elevenlabs-webhook/route.ts": { "maxDuration": 30 },
    "src/app/api/voice/gather/route.ts": { "maxDuration": 10 },
    "src/app/api/cron/daily-digest/route.ts": { "maxDuration": 300 },
    "src/app/api/cron/dunning/route.ts": { "maxDuration": 300 },
    "src/app/api/billing/webhook/route.ts": { "maxDuration": 30 },
    "src/app/api/billing/checkout/route.ts": { "maxDuration": 15 },
    "src/app/api/leads/score/route.ts": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
