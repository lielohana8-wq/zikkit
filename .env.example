# ─────────────────────────────────────────────────────────────
# ZIKKIT — environment (copy to .env.local, and set the same in Vercel)
# ─────────────────────────────────────────────────────────────

# Region / edition. CA = English "Solo" edition (Customers / Quotes / Receipts / Closings)
NEXT_PUBLIC_ZIKKIT_REGION=CA

# Firebase (REQUIRED — no more hardcoded fallback). Use the project for THIS region.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account JSON (single line) — used by API routes (quote acceptance, view tracking)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Public URL of this deployment (used in links sent to customers)
NEXT_PUBLIC_APP_URL=https://app.zikkit.ca

# Extra allowed hostnames for the domain lock (comma separated). *.zikkit.com / *.zikkit.ca / *.vercel.app are always allowed.
ALLOWED_HOSTS=
# DOMAIN_LOCK=off   # disable the lock entirely (not recommended)

# Email — option A (free, instant): your Gmail + a Google App password (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Email — option B: Resend (needs a verified domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS (Twilio) — optional, enables "SMS" in the send dialog. Use a Canadian number for CA.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_CA=

# AI / voice (IL edition only)
ANTHROPIC_API_KEY=
